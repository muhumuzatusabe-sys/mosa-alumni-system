rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==============================================================
    // 1. RBAC & HELPER FUNCTIONS
    // ==============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return isAuthenticated() ? 
        (request.auth.token.role != null ? request.auth.token.role : 
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserData().role : 'GUEST'))
        : 'ANONYMOUS';
    }
    
    function hasRole(role) {
      return isAuthenticated() && (getUserRole() == role);
    }
    
    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }
    
    function isAdmin() {
      return isSuperAdmin() || hasRole('ADMIN');
    }
    
    function isSecretary() {
      return isAdmin() || hasRole('SECRETARY') || hasRole('MEMBERSHIP_ADMIN');
    }
    
    function isTreasurer() {
      return isAdmin() || hasRole('TREASURER');
    }
    
    function isEventsStaff() {
      return isAdmin() || hasRole('EVENTS_ATTENDANCE_ADMIN');
    }
    
    function isPublicity() {
      return isAdmin() || hasRole('PUBLICITY');
    }
    
    function isStaff() {
      return isAdmin() || 
             hasRole('SECRETARY') || 
             hasRole('TREASURER') || 
             hasRole('MEMBERSHIP_ADMIN') || 
             hasRole('DIRECTORY_ADMIN') || 
             hasRole('EVENTS_ATTENDANCE_ADMIN') || 
             hasRole('PUBLICITY') || 
             hasRole('CHAPTER_ADMIN') || 
             hasRole('CUSTOM_STAFF');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==============================================================
    // 2. SYSTEM SETTINGS & COUNTERS
    // ==============================================================
    match /settings/{settingId} {
      allow read: if isStaff();
      allow update, write: if isAdmin();
      allow delete: if false; // System settings must never be deleted
    }

    // ==============================================================
    // 3. CANDIDATE REGISTRATION APPLICATIONS
    // ==============================================================
    match /applications/{applicationId} {
      // Anyone can submit a registration application with PENDING status
      allow create: if request.resource.data.status == 'PENDING'
                    && request.resource.data.email is string
                    && request.resource.data.fullName is string;
      
      // Applicant can track their own application; Staff can review queue
      allow read: if isSecretary() || (isAuthenticated() && request.auth.token.email == resource.data.email);
      
      // Only Secretary / Membership Admin / Super Admin can approve, reject, or assign MA numbers
      allow update: if isSecretary();
      
      // Applications cannot be deleted, except strictly by Super Admin under GDPR/Right to be Forgotten
      allow delete: if isSuperAdmin();
    }

    // ==============================================================
    // 4. VERIFIED ALUMNI REGISTRY
    // ==============================================================
    match /alumni/{alumniId} {
      // Public directory access (sensitive contact details handled by field privacy in app)
      allow read: if true;
      
      // Only authorised Secretariat can mint new verified alumni profiles upon vetting
      allow create: if isSecretary() && request.resource.data.alumniNumber != null;
      
      // Alumni can edit their own profile fields, but CANNOT tamper with alumniNumber, verifiedAt, or verifiedBy
      allow update: if isSecretary() || 
                      (isAuthenticated() && 
                       request.auth.uid == resource.data.internalId &&
                       request.resource.data.alumniNumber == resource.data.alumniNumber &&
                       request.resource.data.verifiedAt == resource.data.verifiedAt &&
                       request.resource.data.verifiedBy == resource.data.verifiedBy);
                       
      // Deletions strictly restricted to Super Admin
      allow delete: if isSuperAdmin();
    }

    // ==============================================================
    // 5. USER ACCOUNTS & PRIVILEGE ELEVATION PROTECTION
    // ==============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      
      // Self-registration is restricted to base USER or ALUMNI roles; CANNOT grant oneself staff/admin
      allow create: if isOwner(userId) && (request.resource.data.role == 'USER' || request.resource.data.role == 'ALUMNI');
      
      // Users can update their profile/preferences but cannot elevate their own role
      allow update: if isSuperAdmin() || 
                      (isOwner(userId) && request.resource.data.role == resource.data.role);
      
      allow delete: if isSuperAdmin();
    }

    // ==============================================================
    // 6. AUDIT TRAIL (IMMUTABLE FORENSIC LOG)
    // ==============================================================
    match /audit_logs/{logId} {
      allow read: if isStaff();
      // Append-only for authenticated system events
      allow create: if isAuthenticated();
      // Tamper-proof: Logs cannot be modified or deleted by anyone, including administrators
      allow update, delete: if false;
    }

    // ==============================================================
    // 7. CAMPUS & INSTITUTIONAL CHAPTERS
    // ==============================================================
    match /chapters/{chapterId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isAuthenticated() && request.auth.token.email in resource.data.adminEmails);
    }

    match /chapter_members/{memberId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.alumniId != null;
      allow update, delete: if isStaff() || 
                            (isAuthenticated() && (request.auth.uid == resource.data.alumniId || request.auth.token.email == resource.data.alumniEmail));
    }

    // ==============================================================
    // 8. EVENTS, TICKETING & QR GATE PASSES
    // ==============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isEventsStaff();
      allow update: if isEventsStaff();
    }

    match /event_registrations/{registrationId} {
      allow read: if isEventsStaff() || (isAuthenticated() && request.auth.uid == resource.data.alumniId);
      allow create: if isAuthenticated() && request.resource.data.alumniId != null;
      allow update, delete: if isEventsStaff() || (isAuthenticated() && request.auth.uid == resource.data.alumniId);
    }

    match /event_attendance/{attendanceId} {
      // Attendance records are verifiable by staff
      allow read: if isEventsStaff();
      // Recorded by staff QR Gate Scanner
      allow create: if isEventsStaff();
      // Tamper-proof gate attendance
      allow update, delete: if false;
    }

    // ==============================================================
    // 9. SMART MEETING ATTENDANCE
    // ==============================================================
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow create, update: if isSecretary() || isEventsStaff();
      allow delete: if isAdmin();
    }

    match /meeting_attendance/{recordId} {
      allow read: if isStaff() || (isAuthenticated() && request.auth.uid == resource.data.attendeeId);
      // Can be submitted via self check-in or assisted by secretariat
      allow create: if isAuthenticated();
      // Can only be updated if meeting is not finalized
      allow update: if isSecretary() && resource.data.state != 'FINALIZED';
      allow delete: if isSecretary() && resource.data.state != 'FINALIZED';
    }

    // ==============================================================
    // 10. PHILANTHROPY, DUES & TREASURY
    // ==============================================================
    match /donation_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isTreasurer();
    }

    match /payments/{paymentId} {
      // Donors see their own records; Treasury & Staff see all
      allow read: if isTreasurer() || (isAuthenticated() && request.auth.uid == resource.data.alumniId);
      
      // Anyone authenticated can submit a contribution/dues payment
      allow create: if isAuthenticated() && request.resource.data.amount > 0;
      
      // ONLY Treasurer or Super Admin can verify, issue official receipts, or decline transactions
      allow update: if isTreasurer();
      
      // Financial records are strictly immutable for statutory audit compliance
      allow delete: if false;
    }

    // ==============================================================
    // 11. COMMUNICATIONS & CIRCULARS
    // ==============================================================
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isPublicity();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isPublicity();
      allow write: if isPublicity();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.alumniId;
      allow create: if isStaff() || isAuthenticated();
    }

    // ==============================================================
    // 12. OPPORTUNITIES & MENTORSHIP
    // ==============================================================
    match /opportunities/{oppId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.postedBy);
    }

    match /mentors/{mentorId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == mentorId || isAdmin());
      allow delete: if isAdmin();
    }

    match /mentorship_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.mentorId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.requesterId;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.mentorId || isAdmin());
      allow delete: if isAdmin();
    }

    // ==============================================================
    // 13. ELECTIONS & DIGITAL VOTING (SECRET BALLOT INTEGRITY)
    // ==============================================================
    match /elections/{electionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /elections/{electionId}/candidates/{candidateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /elections/{electionId}/ballots/{ballotId} {
      // Individual ballots are private; voter can confirm their own vote was cast
      allow read: if isAuthenticated() && request.auth.uid == resource.data.voterAlumniId;
      
      // One vote per verified alumnus; ballot is cast anonymously with cryptographic receipt
      allow create: if isAuthenticated() 
                    && request.auth.uid == request.resource.data.voterAlumniId
                    && request.resource.data.electionId == electionId;
                    
      // Strictly immutable: Once cast, votes cannot be modified or deleted by anyone
      allow update, delete: if false;
    }

    // ==============================================================
    // 14. CMS, WELCOME PAGE & DIGITAL ASSETS
    // ==============================================================
    match /cms_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /welcome_page/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSecretary();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isPublicity();
    }
  }
}
